# Copia para .env e preenche.

# Base de dados (SQLite, ficheiro local)
DATABASE_URL=sqlite:///./padel_streamer.db

# Pasta de dados (logos, snapshots, perfis de ruído, logs)
DATA_DIR=./data

# RTSP default (Hikvision canal principal)
DEFAULT_RTSP_PATH=/Streaming/Channels/101

# Seed inicial do campo (1ª execução). IP/user já têm default no código;
# a password da câmara mete-se AQUI (este ficheiro .env NÃO vai para o git).
SEED_CAMERA_IP=192.168.88.201
SEED_NVR_USER=admin
SEED_RTSP_PATH=/Streaming/Channels/101
SEED_NVR_PASSWORD=

# YouTube RTMP
RTMP_BASE_URL=rtmp://a.rtmp.youtube.com/live2

# YouTube Data API (OAuth) — obtém no Google Cloud Console
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
YOUTUBE_DEFAULT_PRIVACY=unlisted

# GStreamer
GST_LAUNCH_BIN=gst-launch-1.0
# Modelo RNNoise para denoise (opcional)
RNNOISE_MODEL_PATH=

FROZEN_THRESHOLD_SECONDS=30

# Login (dashboard) — muda em produção!
ADMIN_PASSWORD=admin
AUTH_SECRET=muda-este-segredo-aleatorio
